# Optional: override default API base URL.
# Default without this var: /api/v1 (through Vite proxy)
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# Vite dev proxy target for /api
# Local host machine
VITE_API_PROXY_TARGET=http://localhost:8000

# If frontend runs inside Docker Compose, use the backend service name instead:
# VITE_API_PROXY_TARGET=http://backend:8000
